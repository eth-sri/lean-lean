ARG BASE_IMAGE=scratch
FROM ${BASE_IMAGE}

ARG INSTANCE_ID
ARG SOURCE_TREE_SHA256
ARG ENVIRONMENT_ID
ARG BUILD_TARGET=""
ARG LEAN_BUILD_THREADS=8

COPY source/ /testbed/
COPY warm-build/ /testbed/.lake/build/
WORKDIR /testbed

RUN test -s lean-toolchain && \
    { test -s lakefile.toml || test -s lakefile.lean; } && \
    test -d .lake/packages && test -d .lake/build && \
    ulimit -n 1048576 && \
    if [ -n "${BUILD_TARGET}" ]; then \
      LEAN_NUM_THREADS="${LEAN_BUILD_THREADS}" lake build ${BUILD_TARGET}; \
    else \
      LEAN_NUM_THREADS="${LEAN_BUILD_THREADS}" lake build; \
    fi

RUN rm -rf .git && \
    git init -q && \
    git config user.name "A U Thor" && \
    git config user.email "author@example.com" && \
    printf '.lake/\n' > .gitignore && \
    git add . && \
    git commit -qm init && \
    git rev-parse HEAD > /.init_commit

LABEL org.openai.leanlean.instance_id="${INSTANCE_ID}" \
      org.openai.leanlean.repo_variant="stripped" \
      org.openai.leanlean.source_isolation="standalone_v3" \
      org.openai.leanlean.materialization="shared_environment_v1" \
      org.openai.leanlean.environment_id="${ENVIRONMENT_ID}" \
      org.openai.leanlean.source_tree_sha256="${SOURCE_TREE_SHA256}"

CMD ["sleep", "infinity"]
